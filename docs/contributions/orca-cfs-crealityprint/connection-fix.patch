+    def _refresh_connection(self):
+        """Resolve the selected print host on the GUI thread; keep material state per Moonraker host."""
+        impostazioni = self._settings()
+        mappings = impostazioni.get("moonraker_hosts") or {}
+        selected = host_da_preset()
+        host = resolve_moonraker_host(selected, mappings) if selected else (
+            "" if mappings else normalize_host(impostazioni.get("host")))
+        if self._connection_initialized and host == self._host:
+            return False
+        saved = impostazioni.get("caricati_per_host")
+        cache = {normalize_host(key): list(value) for key, value in saved.items()
+                 if normalize_host(key) and isinstance(value, list)} if isinstance(saved, dict) else {}
+        legacy_host = resolve_moonraker_host(impostazioni.get("host"), mappings)
+        if legacy_host:
+            value = impostazioni.get("caricati")
+            cache[legacy_host] = list(value) if isinstance(value, list) else []
+        if self._host and self._letti:
+            cache[self._host] = list(self._carica["caricati"])
+        caricati = list(cache.get(host, [])) if host else []
+        # Invalidate before replacing state, so a poller cannot pair the new host with old materials.
+        self._host = ""
+        self._connection_initialized = True
+        self._stato = {"connessa": False, "unita": [], "errore": "", "ora": ""}
+        self._da_caricare = []
+        self._letti = True
+        self._riprova = {}
+        self._errori = {}
+        self._aperta_da_sola = False
+        self._carica = {"adl": None, "caricati": caricati, "mancano": [], "errore": ""}
+        self._host = host
+        self._salva(host=host, caricati=caricati, caricati_per_host=cache)
+        self._wake.set()
+        return True
