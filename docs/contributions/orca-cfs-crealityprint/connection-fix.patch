+def resolve_moonraker_host(selected, mappings):
+    """Use an optional per-printer Moonraker alias without changing Orca's print host."""
+    selected = normalize_host(selected)
+    if not selected or not isinstance(mappings, dict):
+        return ""
+    for key, target in mappings.items():
+        if normalize_host(key) == selected:
+            return normalize_host(target)
+    return selected
+
